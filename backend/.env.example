# Database
DATABASE_URL=postgresql+asyncpg://fp_user:fp_password@localhost:5432/fp_db
DATABASE_URL_SYNC=postgresql://fp_user:fp_password@localhost:5432/fp_db

# Security
SECRET_KEY=change-me-use-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# TOTP
TOTP_ISSUER=FP Finanzas Personales

# App
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# Email (opcional, para alertas)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fp.hanshatch.com

# Backup (solo producción)
GPG_PASSPHRASE=
RCLONE_REMOTE=gdrive:fp-backups
